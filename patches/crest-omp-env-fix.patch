# ===========================================================================
# CREST 3.0.2 - child thread budget never reaches the external xtb process
# ---------------------------------------------------------------------------
# Symptom : in subprocess mode (TOML method="gfn", external xtb binary) a
#           batch of 6 MTDs on 40 threads finishes in ~2m48s per MTD instead
#           of the ~44 s CREST predicts; per-process CPU stays at 60-70 % and
#           htop shows a lot of red (system/kernel) time.
# Cause   : POSIX setenv(const char*, const char*, int) takes THREE arguments,
#           but the iso_c_binding interface declared only two.  The
#           "overwrite" flag was therefore read from an undefined register;
#           whenever it happened to be 0, setenv() refused to update an
#           ALREADY EXISTING variable.  crest_env.sh exports
#           OMP_NUM_THREADS=40 / OPENBLAS_NUM_THREADS=1 / MKL_NUM_THREADS=1
#           before CREST even starts, so ompenvset() could not lower
#           OMP_NUM_THREADS to cores_per_job nor raise the BLAS budgets.
#           Every xtb child then inherited OMP_NUM_THREADS=40 while its BLAS
#           stayed single-threaded -> gross over-subscription of the OMP
#           layer with a serialised BLAS layer underneath.
# Fix     : declare the third argument and pass overwrite=1 at all three call
#           sites (setenv_string / setenv_int / setenv_float).
#           Additionally ompenvset() now also exports OMP_MAX_ACTIVE_LEVELS=1
#           so that the child does not spawn "threads within threads" (xtb
#           runs OpenMP loops and calls a threaded BLAS from them; with
#           outer=inner=N this yields up to N*N runnable threads per job).
#           That single line can be dropped to revert the extra guard.
# Apply   : git apply -p1 crest-omp-env-fix.patch      (from the src/ parent)
# ===========================================================================
diff --git a/src/iomod.F90 b/src/iomod.F90
--- a/src/iomod.F90
+++ b/src/iomod.F90
@@ -35,10 +35,22 @@
   end interface
 
   interface
-    integer(kind=c_int) function c_setenv(c_name,c_VALUE) bind(c,name="setenv")
+    !> NOTE: POSIX setenv() takes THREE arguments:
+    !>   int setenv(const char *name, const char *value, int overwrite);
+    !> The binding used to declare only two, so the "overwrite" flag was
+    !> read from an undefined register.  If that happened to be 0, setenv()
+    !> silently REFUSED to update an already existing variable.
+    !> Consequences: ompenvset() could not change OMP_NUM_THREADS /
+    !> MKL_NUM_THREADS / OPENBLAS_NUM_THREADS, so externally started
+    !> programs (xtb, orca, ... subprocesses) inherited whatever the
+    !> calling shell had exported - e.g. OPENBLAS_NUM_THREADS=1, which
+    !> serialises precisely the BLAS work that xtb parallelises with
+    !> OMP_NUM_THREADS.
+    integer(kind=c_int) function c_setenv(c_name,c_VALUE,c_overwrite) bind(c,name="setenv")
       use iso_c_binding
       character(kind=c_char)   :: c_name(*)
       character(kind=c_char)   :: c_VALUE(*)
+      integer(kind=c_int),value :: c_overwrite
     end function
   end interface
   interface setenv
