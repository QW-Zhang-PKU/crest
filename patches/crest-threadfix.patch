+      if (maxdev > 0.0_wp.and.maxdev0 < huge(1.0_wp).and.maxdev < huge(1.0_wp)) then
+        rho = (maxdev/maxdev0)**(1.0_wp/real(icyc))
+        have_rho = (rho > 1.0e-8_wp.and.rho < 1.0_wp)
