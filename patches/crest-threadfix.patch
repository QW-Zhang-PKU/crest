+!>     (target unreachable from any geometry) apart from a REDUNDANT one
+!>     (target reachable, but the solver cannot get there in maxcyc sweeps).
+!========================================================================================!
+  subroutine shake_failreport(shk,maxdev,maxdev0,icyc)
+    implicit none
