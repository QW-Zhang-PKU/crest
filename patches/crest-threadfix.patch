+    if (estat /= 0 .or. len_trim(val) == 0) val = 'crest_work'
+    if (trim(val) == 'none' .or. trim(val) == '0') return
+    dir = trim(val)
+    l = len_trim(dir)
+    do while (l > 1 .and. dir(l:l) == '/')
