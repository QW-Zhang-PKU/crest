+      rdist(1:env%nhardcons) = env%hcdist(1:env%nhardcons)
+      call move_alloc(iatms,env%hcatms)
+      call move_alloc(rdist,env%hcdist)
+    end if
+    env%nhardcons = n
+    env%hcatms(1,n) = i
+    env%hcatms(2,n) = j
+    env%hcdist(n) = dist
+    return
+  end subroutine add_hardcons
