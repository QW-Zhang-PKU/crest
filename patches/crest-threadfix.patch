+!========================================================================================!
+  subroutine md_stopfile_delete(fname)
+    implicit none
+    character(len=*),intent(in) :: fname
+    integer :: u,ios
+    open (newunit=u,file=trim(fname),status='old',iostat=ios)
+    if (ios /= 0) return
+    close (u,status='delete',iostat=ios)
+    return
+  end subroutine md_stopfile_delete
