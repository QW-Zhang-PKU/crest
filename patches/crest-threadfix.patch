+!==================================================================!
+!> count_xyz_structures: nat (the LARGEST structure) and nall of an
+!> XYZ ensemble, WITHOUT parsing a single coordinate.
+!>
+!> LOCAL CHANGE (2026-09-27).  Semantics are identical to rdensembleparam()
+!> (nat = max over frames, nall = number of readable frames), but the per-atom
+!> line is consumed as a RAW record instead of being list-parsed into
+!> (symbol,x,y,z).  rdensembleparam() is a FULL parse and is called in places
+!> that only need the size before allocating the arrays - crest_multilevel_oloop
+!> does it twice per multilevel level, sort_and_check once per level.  None of
+!> those callers looks at a coordinate, and list-directed numeric parsing costs
+!> roughly an order of magnitude more than reading the record.
+!>
+!> Use this ONLY where nat/nall are all that is wanted; keep
+!> rdensembleparam() wherever the optional `conform` check or the actual
+!> coordinates are needed.
+!==================================================================!
+  subroutine count_xyz_structures(fname,nat,nall)
+    implicit none
+    character(len=*),intent(in) :: fname
+    integer,intent(out) :: nat,nall
+    integer :: dum,ich,io,i,iosum
+    logical :: ex
+    character(len=256) :: line
+    nat = 0
+    nall = 0
+    inquire (file=fname,exist=ex)
+    if (.not.ex) return
+    open (newunit=ich,file=fname)
+    do
+      read (ich,*,iostat=io) dum
+      if (io < 0) exit
+      if (io > 0) cycle
+      !> comment line - no iolist, i.e. the record is skipped, not parsed
+      read (ich,*,iostat=io)
+      if (io < 0) exit
+      !> the coordinate block, raw.  iosum reproduces the original guard:
+      !> a frame whose block could not be read in full is NOT counted.
+      iosum = 0
+      do i = 1,dum
+        read (ich,'(a)',iostat=io) line
+        if (io < 0) exit
+        iosum = iosum+io
+      end do
+      if (iosum > 0) cycle
+      nat = max(dum,nat)
+      nall = nall+1
+    end do
+    close (ich)
+    return
+  end subroutine count_xyz_structures
 
