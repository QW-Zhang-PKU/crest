+!========================================================================================!
+  subroutine add_hardcons(env,i,j,dist)
+    use crest_parameters,only:wp
+    use crest_data
+    implicit none
+    type(systemdata),intent(inout) :: env
+    integer,intent(in) :: i,j
+    real(wp),intent(in) :: dist
+    integer :: n,m
+    integer,allocatable :: iatms(:,:)
+    real(wp),allocatable :: rdist(:)
+
+    if (i < 1.or.j < 1.or.i == j) return
+    n = env%nhardcons+1
+    if (.not.allocated(env%hcatms)) then
