+    else
+      wbofile = 'ORCA.out'
+    end if
+
+    inquire (file=wbofile,exist=ex)
+    if (.not.ex) then
+      write (stderr,'(3a)') '**WARNING** ORCA output ',trim(wbofile),&
+              & ' not found - cannot read bond orders'
