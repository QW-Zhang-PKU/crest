 !========================================================================================!
+!> singlepoint_mol: the ENERGY ONLY counterpart of engrad_mol().
+!>
+!> WHY: there are stages that rank structures by energy and never look at the
+!> gradient - most prominently crest_sploop(), the
+!> "Singlepoint re-ranking for N structures" step of the refine.  It used to
+!> call engrad(), so ORCA (and any other subprocess calculator) computed a
+!> gradient that was then thrown away: in crest_sploop the gradient array was
+!> filled and deallocated without a single read.  For a DFT level with a
+!> solvation model that is a CP-SCF / Z-vector solve plus the CPCM gradient
+!> contribution, on every single structure of the ensemble, for nothing.
+!>
+!> HOW: calc%nogr is raised around the call.  potential_core() reads it and,
+!> for ORCA, dispatches to ORCA_sp(), which writes the input template WITHOUT
+!> the EnGrad keyword and parses "FINAL SINGLE POINT ENERGY" out of ORCA.out
+!> - the very number ORCA would have put into ORCA.engrad.  Everything else
+!> (ONIOM, weighted energy summation, constraints, printout) is the untouched
+!> engrad_mol() machinery, so the returned energy is bit-for-bit the same as
+!> from engrad(); only the gradient comes back as zero and is discarded here.
+!>
+!> USAGE: for calculators that cannot skip the gradient (xtb, tblite, GFN-FF,
+!> ...) this behaves exactly like engrad() - no change, no risk.
+!========================================================================================!
+  subroutine singlepoint_mol(mol,calc,energy,iostatus)
+    implicit none
+    type(coord),target :: mol
+    type(calcdata) :: calc
+    real(wp),intent(inout) :: energy
+    integer,intent(out) :: iostatus
+
+    real(wp),allocatable :: grd(:,:)
+    logical :: save_nogr
+
+    allocate (grd(3,mol%nat),source=0.0_wp)
+
+    save_nogr = calc%nogr
+    calc%nogr = .true.
+    call engrad_mol(mol,calc,energy,grd,iostatus)
+    calc%nogr = save_nogr
+
+    deallocate (grd)
+    return
+  end subroutine singlepoint_mol
+
