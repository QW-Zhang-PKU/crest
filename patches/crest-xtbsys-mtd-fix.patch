+!> Runs of blanks are collapsed to one so that an accidental '--gbe   thf'
+!> cannot put an empty argument onto the shell command line.
+!------------------------------------------------------------------------------!
+  subroutine append_gxtb_solv(other)
+    implicit none
+    character(len=:),allocatable,intent(inout) :: other
+    character(len=128) :: sv
+    character(len=:),allocatable :: clean
+    integer :: k
+    sv = ' '
+    call getenv('CREST_GXTB_SOLV',sv)
+    if (len_trim(sv) <= 0) return
+    clean = ''
+    do k = 1,len_trim(sv)
+      if (sv(k:k) == ' ') then
+        if (len(clean) > 0.and.clean(len(clean):len(clean)) /= ' ') clean = clean//' '
+      else
+        clean = clean//sv(k:k)
+      end if
+    end do
+    if (len(clean) <= 0) return
+    if (.not.allocated(other)) then
+      other = trim(clean)
+    else
+      other = trim(other)//' '//trim(clean)
+    end if
+    return
+  end subroutine append_gxtb_solv
