+!---------------------------------------------------------------------------------------!
+  pure function locase(str) result(out)
+    implicit none
+    character(len=*),intent(in) :: str
+    character(len=len(str)) :: out
+    integer :: i,ic
+    out = str
+    do i = 1,len_trim(str)
+      ic = iachar(out(i:i))
+      if (ic >= iachar('A').and.ic <= iachar('Z')) out(i:i) = char(ic+32)
