+!---------------------------------------------------------------------------------------!
+  pure function has_engrad(line) result(found)
+    implicit none
+    character(len=*),intent(in) :: line
+    logical :: found
+    integer :: i,n
+    found = .false.
+    n = len_trim(line)
+    do i = 1,n-len(ENG)+1
